{
  "id": "2hhisinsfuqmo2cl",
  "title": "Arx - EasterEggs / Flow – The Arctic Swimmer",
  "dialogueTree": [
    {
      "id": 5,
      "articyId": "89jrlaalpzu5fh4t",
      "speaker": "N/A -> N/A",
      "english": "\"I am immortal.\"",
      "polish": "„Jestem nieśmiertelny”.",
      "belarusian": "\"Я несмяротны.\"",
      "links": []
    },
    {
      "id": 8,
      "articyId": "g3jersi93dul98vr",
      "speaker": "N/A -> N/A",
      "english": "\"Unstoppable force.\"",
      "polish": "„Siła nie do zatrzymania”.",
      "belarusian": "\"Няспынная сіла.\"",
      "links": []
    },
    {
      "id": 2,
      "articyId": "eeogbhk7jr5e384z",
      "speaker": "N/A -> N/A",
      "english": "\"Willpower embodied.\"",
      "polish": "„Uosobienie siły woli”.",
      "belarusian": "\"Увасабленне сілы волі.\"",
      "links": []
    },
    {
      "id": 15,
      "articyId": "9dlzavtqpmxsq804",
      "speaker": "N/A -> N/A",
      "english": "\"Can't feel my fucking lingam.\"",
      "polish": "„Kurwa, aż nie czuję swojego lingam”.",
      "belarusian": "\"Свайго ёбанага лінгама не адчуваю.\"",
      "links": []
    },
    {
      "id": 11,
      "articyId": "x5tqu4klygxtw0f4",
      "speaker": "N/A -> N/A",
      "english": "\"I'm only getting stronger.\"",
      "polish": "„Staję się tylko silniejszy”.",
      "belarusian": "\"Я толькі мацнею.\"",
      "links": []
    },
    {
      "id": 19,
      "articyId": "3al0n2h2zonopuqs",
      "speaker": "N/A -> N/A",
      "english": "\"Stop worrying and start living.\"",
      "polish": "„Przestań się martwić i zacznij żyć”.",
      "belarusian": "\"Перастань турбавацца і пачні жыць.\"",
      "links": []
    },
    {
      "id": 20,
      "articyId": "pgv75uxbv_nrsk4p",
      "speaker": "N/A -> N/A",
      "english": "\"The clock goes only one way.\"",
      "polish": "„Czas biegnie tylko do przodu”.",
      "belarusian": "\"Гадзіннік ідзе толькі ў адзін бок.\"",
      "links": []
    },
    {
      "id": 10,
      "articyId": "n8q56yig92_u4kzv",
      "speaker": "N/A -> N/A",
      "english": "\"Do you even meditate?\"",
      "polish": "„Medytujesz ty w ogóle?”",
      "belarusian": "\"Ты ўвогуле медытуеш?\"",
      "links": []
    },
    {
      "id": 6,
      "articyId": "dhvffsdsrkwp010_",
      "speaker": "N/A -> N/A",
      "english": "\"Are you getting stronger or weaker right now?\"",
      "polish": "„Stajesz się właśnie silniejszy czy słabszy?”",
      "belarusian": "\"Ты проста зараз мацнееш ці слабнеш?\"",
      "links": []
    },
    {
      "id": 4,
      "articyId": "pp7n_n2l3zopl85f",
      "speaker": "N/A -> N/A",
      "english": "\"Get your testosterone levels checked.\"",
      "polish": "„Sprawdź sobie poziom testosteronu”.",
      "belarusian": "\"Правер свой узровень тэстастэрону.\"",
      "links": []
    },
    {
      "id": 17,
      "articyId": "fft_l0l50s6tb3k7",
      "speaker": "N/A -> N/A",
      "english": "\"With TRT it's good to start early.\"",
      "polish": "„Testosteron warto zacząć uzupełniać wcześniej”.",
      "belarusian": "\"З ТЗТ лепш пачынаць раней.\"",
      "links": []
    },
    {
      "id": 3,
      "articyId": "53kmhe2mrjpkyg54",
      "speaker": "N/A -> N/A",
      "english": "\"The juice is worth the squeeze.\"",
      "polish": "„To gra warta świeczki”.",
      "belarusian": "\"Гульня вартая свечак.\"",
      "links": []
    },
    {
      "id": 7,
      "articyId": "2r58j35_p5iqcumr",
      "speaker": "N/A -> N/A",
      "english": "\"I harpoon-hunt all my meals.\"",
      "polish": "„Wszystkie swoje posiłki łowię harpunem”.",
      "belarusian": "\"Усю сваю ежу я здабываю гарпуном.\"",
      "links": []
    },
    {
      "id": 9,
      "articyId": "5_z2zn9ulj9qqltd",
      "speaker": "N/A -> N/A",
      "english": "\"Warmer than you fucking think, grandpa.\"",
      "polish": "„Cieplej mi, niż ci się, kurwa, wydaje, dziadziu”.",
      "belarusian": "\"Цяплей, чым ты, курва, думаеш, дзед.\"",
      "links": []
    },
    {
      "id": 18,
      "articyId": "atg_uz9a2ely1d7f",
      "speaker": "N/A -> N/A",
      "english": "\"I'm the guy who *doesn't* need the ambulance.\"",
      "polish": "„Jestem tym gościem, który *nie potrzebuje* karetki”.",
      "belarusian": "\"Я той хлопец, якому *не* патрэбная хуткая.\"",
      "links": []
    },
    {
      "id": 14,
      "articyId": "cbd3jpbb8im8faux",
      "speaker": "N/A -> N/A",
      "english": "\"Even dying is an art.\"",
      "polish": "„Nawet umieranie jest sztuką”.",
      "belarusian": "\"Нават паміранне — гэта мастацтва.\"",
      "links": []
    }
  ]
}
