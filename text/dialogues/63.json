{
  "id": "0x010000070001A52F",
  "title": "ICE / NOID barks",
  "description": "Things Noid says inside the church.",
  "dialogueTree": [
    {
      "id": 2,
      "articyId": "0x010000070001A530",
      "speaker": "Noid -> N/A",
      "english": "\"No one can find us here.\"",
      "polish": "„Nikt nas tu nie znajdzie”.",
      "belarusian": "\"Ніхто нас тут не знойдзе.\"",
      "links": []
    },
    {
      "id": 3,
      "articyId": "0x010000070001A536",
      "speaker": "Noid -> N/A",
      "english": "\"This is *our* little utopia.\"",
      "polish": "„To *nasza* mała utopia”.",
      "belarusian": "\"Гэта *наша* маленькая ўтопія.\"",
      "links": []
    },
    {
      "id": 4,
      "articyId": "0x010000070001A712",
      "speaker": "Noid -> N/A",
      "english": "\"The carpentry in here is magnificent.\"",
      "polish": "„Ten budynek to pokaz wspaniałej ciesielki”.",
      "belarusian": "\"Цяслярства тут проста цудоўнае.\"",
      "links": []
    },
    {
      "id": 5,
      "articyId": "0x010000070001A719",
      "speaker": "Noid -> N/A",
      "english": "\"Are they really gonna let us have this?\"",
      "polish": "„Naprawdę pozwolą nam tu zostać?”",
      "belarusian": "\"Яны сапраўды аддадуць нам гэта?\"",
      "links": []
    },
    {
      "id": 8,
      "articyId": "0x010000070001A720",
      "speaker": "Noid -> N/A",
      "english": "\"Whatever it takes, man... whatever it takes.\"",
      "polish": "„Za wszelką cenę... Za wszelką cenę”.",
      "belarusian": "\"Чаго б гэта ні каштавала, чувак... чаго б гэта ні каштавала.\"",
      "links": []
    },
    {
      "id": 7,
      "articyId": "0x010000070001A727",
      "speaker": "Noid -> N/A",
      "english": "\"New sines, new ideas, new beginning.\"",
      "polish": "„Nowe fale, nowe pomysły, nowy początek”.",
      "belarusian": "\"Новыя сінусы, новыя ідэі, новы пачатак.\"",
      "links": []
    }
  ]
}
