      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"The future belongs to Measurehead.\"",
      "polish": "„Przyszłość należy do Miarogłowego”.",
      "belarusian": "\"Будучыня належыць Мерагаловаму.\"",
      "links": []
    },
    {
      "id": 10,
      "articyId": "0x0100002F000099B1",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"No man matches Measurehead.\"",
      "polish": "„Nikt nie dorówna Miarogłowemu”.",
      "belarusian": "\"Ніводзін мужчына не зраўняецца з Мерагаловым.\"",
      "links": []
    },
    {
      "id": 9,
      "articyId": "0x0100002F000099AC",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"You're the right stuff, Measurehead.\"",
      "polish": "„Jesteś idealny, Miarogłowy”.",
      "belarusian": "\"Ты тое, што трэба, Мерагаловы.\"",
      "links": []
    },
    {
      "id": 4,
      "articyId": "0x0100002F00008F6A",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"Looking monolithic.\"",
      "polish": "„Wygląda jak monolit”.",
      "belarusian": "\"Выглядаеш маналітна.\"",
      "links": []
    },
    {
      "id": 3,
      "articyId": "0x0100002F000099A7",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"Measurehead crushes all.\"",
      "polish": "„Miarogłowy miażdży wszystko”.",
      "belarusian": "\"Мерагаловы раздушвае ўсіх.\"",
      "links": []
    },
    {
      "id": 8,
      "articyId": "0x0100002F000099B6",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"Nobody comes close to Measurehead.\"",
      "polish": "„Nikt nie ma nawet startu do Miarogłowego”.",
      "belarusian": "\"Ніхто і блізка не падбярэцца да Мерагаловага.\"",
      "links": []
    },
    {
      "id": 11,
      "articyId": "0x0100002F000099CA",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"Measurehead makes all men quiver.\"",
      "polish": "„Wszyscy drżą przed Miarogłowym”.",
      "belarusian": "\"Перад Мерагаловым дрыжаць усе мужчыны.\"",
      "links": []
    },
    {
      "id": 5,
      "articyId": "0x0100002F000099D2",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"More than enough to please a woman.\"",
      "polish": "„Wystarczy z nawiązką, żeby zadowolić kobietę”.",
      "belarusian": "\"Больш чым дастаткова, каб задаволіць жанчыну.\"",
      "links": []
    },
    {
      "id": 6,
      "articyId": "0x0100002F000099E0",
      "speaker": "Measurehead's Babe -> N/A",
      "english": "\"Measurehead is a powerful man.\"",
      "polish": "„Miarogłowy to potężny człowiek”.",
      "belarusian": "\"Мерагаловы — магутны чалавек.\"",
