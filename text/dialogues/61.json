{
  "id": "0x010000070001A447",
  "title": "ICE / ACELE barks",
  "description": "Things Acele says, when on ice.",
  "dialogueTree": [
    {
      "id": 5,
      "articyId": "0x010000070001A45D",
      "speaker": "Acele -> N/A",
      "english": "\"Damn it's cold outside...\"",
      "polish": "„Szlag, ale zimno...”",
      "belarusian": "\"Чорт, як жа холадна на вуліцы...\"",
      "links": []
    },
    {
      "id": 11,
      "articyId": "0x010000070001A46B",
      "speaker": "Acele -> N/A",
      "english": "\"The frequency can't be *that* low...\"",
      "polish": "„Częstotliwość nie może być aż *tak* niska...”",
      "belarusian": "\"Частата не можа быць *настолькі* нізкай...\"",
      "links": []
    },
    {
      "id": 8,
      "articyId": "0x010000070001A464",
      "speaker": "Acele -> N/A",
      "english": "\"Oh, here we go...\"",
      "polish": "„O, proszę bardzo...”",
      "belarusian": "\"О, пачынаецца...\"",
      "links": []
    },
    {
      "id": 2,
      "articyId": "0x010000070001A6E9",
      "speaker": "Acele -> N/A",
      "english": "*teeth clattering*",
      "polish": "*dzwoni zębami*",
      "belarusian": "*зубы ляскаюць*",
      "links": []
    },
    {
      "id": 3,
      "articyId": "0x010000070001A44F",
      "speaker": "Acele -> N/A",
      "english": "\"It's creaking really loud.\"",
      "polish": "„Trzeszczy naprawdę głośno”.",
      "belarusian": "\"Рыпіць вельмі гучна.\"",
      "links": []
    },
    {
      "id": 9,
      "articyId": "0x010000070001A455",
      "speaker": "Acele -> N/A",
      "english": "\"Sounds like it's smiling.\"",
      "polish": "„Brzmi, jak śmiech”.",
      "belarusian": "\"Гучыць так, нібы яно ўсміхаецца.\"",
      "links": []
    },
    {
      "id": 7,
      "articyId": "0x010000070001A6F0",
      "speaker": "Acele -> N/A",
      "english": "\"Much warmer in here.\"",
      "polish": "„Tu jest znacznie cieplej”.",
      "belarusian": "\"Тут значна цяплей.\"",
      "links": []
    },
    {
      "id": 10,
      "articyId": "0x010000070001A6FB",
      "speaker": "Acele -> N/A",
      "english": "\"Beautiful...\"",
      "polish": "„Pięknie...”",
      "belarusian": "\"Прыгожа...\"",
      "links": []
    },
    {
      "id": 4,
      "articyId": "0x010000070001A703",
      "speaker": "Acele -> N/A",
      "english": "\"This place must have a mind of its own...\"",
      "polish": "„To miejsce musi mieć własny umysł...”",
      "belarusian": "\"У гэтага месца, пэўна, ёсць уласны розум...\"",
      "links": []
    }
  ]
}
