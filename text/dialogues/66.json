{
  "id": "0x010000070001A7A2",
  "title": "JAM / HUMANITARIAN AID barks",
  "description": "Things Siileng says.",
  "dialogueTree": [
    {
      "id": 2,
      "articyId": "0x010000070001A7AC",
      "speaker": "Siileng -> N/A",
      "english": "\"Everything is good here!\"",
      "polish": "„Tutaj wszystko w porządku!”",
      "belarusian": "\"Тут усё выдатна!\"",
      "links": []
    },
    {
      "id": 8,
      "articyId": "0x010000070001A7BA",
      "speaker": "Siileng -> N/A",
      "english": "\"I let the goods do the talking.\"",
      "polish": "„Mój towar mówi sam za siebie”.",
      "belarusian": "\"Мой тавар гаворыць сам за сябе.\"",
      "links": []
    },
    {
      "id": 4,
      "articyId": "0x010000070001A7C1",
      "speaker": "Siileng -> N/A",
      "english": "\"Step right up, mister!\"",
      "polish": "„Zapraszam szanownego pana!”",
      "belarusian": "\"Падыходзьце бліжэй, шаноўны!\"",
      "links": []
    },
    {
      "id": 5,
      "articyId": "0x010000070001A7B3",
      "speaker": "Siileng -> N/A",
      "english": "\"There's something here for everyone!\"",
      "polish": "„Mam tu coś dla każdego!”",
      "belarusian": "\"У мяне знойдзецца штосьці для кожнага!\"",
      "links": []
    },
    {
      "id": 10,
      "articyId": "0x010000070001A7C8",
      "speaker": "Siileng -> N/A",
      "english": "\"You're *guaranteed* to find something exciting!\"",
      "polish": "„*Gwarantuję*, że każdy znajdzie tu coś ekscytującego!”",
      "belarusian": "\"Вы *гарантавана* знойдзеце нешта захапляльнае!\"",
      "links": []
    },
    {
      "id": 6,
      "articyId": "0x010000070001A7CF",
      "speaker": "Siileng -> N/A",
      "english": "\"Astonishing quality! Unbelievable prices!\"",
      "polish": "„Oszałamiająca jakość! Niewiarygodne ceny!”",
      "belarusian": "\"Ашаламляльная якасць! Неверагодныя кошты!\"",
      "links": []
    },
    {
      "id": 7,
      "articyId": "0x010000070001A7EA",
      "speaker": "Siileng -> N/A",
      "english": "\"Deals so good you just *can't* pass this up!\"",
      "polish": "„Okazje tak dobre, że *nie sposób* ich przepuścić!”",
      "belarusian": "\"Такія выгадныя прапановы, што проста *нельга* прайсці міма!\"",
      "links": []
    },
    {
      "id": 9,
      "articyId": "0x010000070001A7F1",
      "speaker": "Siileng -> N/A",
      "english": "\"I'm practically giving goods away here.\"",
      "polish": "„Właściwie rozdaję towar za darmo”.",
      "belarusian": "\"Я практычна задарма аддаю гэты тавар.\"",
      "links": []
    }
  ]
}
