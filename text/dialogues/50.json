{
  "id": "0x01000007000199B2",
  "title": "VILLAGE / ROSEMARY barks",
  "description": "Stuff Rosemary says.",
  "dialogueTree": [
    {
      "id": 6,
      "articyId": "0x01000007000199EE",
      "speaker": "Rosemary -> N/A",
      "english": "\"That's just life, friend.\"",
      "polish": "„Takie jest życie, przyjacielu”.",
      "belarusian": "\"Такое жыццё, сябра\".",
      "links": []
    },
    {
      "id": 2,
      "articyId": "0x01000007000199F4",
      "speaker": "Rosemary -> N/A",
      "english": "\"Are you drinking that?\"",
      "polish": "„Pijesz to?”",
      "belarusian": "\"Ты гэта п'еш?\"",
      "links": []
    },
    {
      "id": 5,
      "articyId": "0x0100000700019A11",
      "speaker": "Rosemary -> N/A",
      "english": "\"Doctors are idiots, buddy-boy.\"",
      "polish": "„Lekarze to idioci, koleżko”.",
      "belarusian": "\"Лекары — гэта ідыёты, дружа\".",
      "links": []
    },
    {
      "id": 4,
      "articyId": "0x01000007000199FA",
      "speaker": "Rosemary -> N/A",
      "english": "\"What was I gonna say?\"",
      "polish": "„Co ja chciałem powiedzieć?”",
      "belarusian": "\"Што я хацеў сказаць?\"",
      "links": []
    },
    {
      "id": 9,
      "articyId": "0x0100000700019A00",
      "speaker": "Rosemary -> N/A",
      "english": "\"I'm not running tabs. It's bad for business.\"",
      "polish": "„Nie sprzedaję na kreskę. To się nie opłaca”.",
      "belarusian": "\"Я не вяду ўлік. Гэта шкодзіць бізнесу\".",
      "links": []
    },
    {
      "id": 10,
      "articyId": "0x0100000700019A57",
      "speaker": "Rosemary -> N/A",
      "english": "\"Look, opening it with my eye-socket again... No problemo.\"",
      "polish": "„Patrz, znowu otworzę oczodołem... Nie widzę problemu”.",
      "belarusian": "\"Глядзі, зноў адкаркоўваю сваёй вачніцай... Ноў проблем\".",
      "links": []
    },
    {
      "id": 3,
      "articyId": "0x0100000700019A6C",
      "speaker": "Rosemary -> N/A",
      "english": "\"The way she goes, buddy-boy...\"",
      "polish": "„Jak ona się rusza, koleżko...”",
      "belarusian": "\"Як яна рухаецца, дружа...\"",
      "links": []
    },
    {
      "id": 7,
      "articyId": "0x010000070001A576",
      "speaker": "Rosemary -> N/A",
      "english": "\"The way she fucking goes...\"",
      "polish": "„Jak ona się, kurwa, rusza...”",
      "belarusian": "\"Як яна, курва, рухаецца...\"",
      "links": []
    }
  ]
}